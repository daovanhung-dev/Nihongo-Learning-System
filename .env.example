# Documentation-only root environment template.
# Frontend public values belong in frontend/src/environments/environment.local.ts
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY

# Backend secrets: set with Supabase CLI secrets; never commit real values.
GEMINI_API_KEY=SET_WITH_SUPABASE_SECRETS
